# ====== Firebase (Firestore) ======
# Cách 1 - ĐƠN GIẢN NHẤT: dán nguyên nội dung file JSON service account vào 1 dòng duy nhất
# (Firebase Console → Project settings → Service accounts → Generate new private key)
# Khi dán vào Vercel, paste nguyên văn cả file JSON làm giá trị của biến này.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Cách 2 - nếu không muốn dán cả JSON, tách ra 3 biến (lấy từ cùng file JSON ở trên):
# FIREBASE_PROJECT_ID="ten-project-firebase"
# FIREBASE_CLIENT_EMAIL="xxx@ten-project.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Chuỗi bí mật bất kỳ để ký cookie đăng nhập admin - đổi thành chuỗi ngẫu nhiên dài khi deploy thật
AUTH_SECRET="doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-that-dai"

# Mật khẩu admin ban đầu - chỉ dùng lúc seed lần đầu, sau đó đổi trong trang Cài đặt
INITIAL_ADMIN_PASSWORD="admin123"

# Khoá bí mật để mở trang tạo tài khoản admin lần đầu qua trình duyệt (không cần terminal)
# Tự đặt 1 chuỗi bất kỳ khó đoán, ví dụ: SETUP_KEY="mokhoa-2026-xyz"
# Sau khi deploy xong, mở link: https://ten-du-an-cua-ban/api/setup?key=GIA_TRI_BAN_DAT_O_DAY
SETUP_KEY="doi-chuoi-nay-thanh-1-chuoi-bat-ky-kho-doan"

# ====== Gửi mail cho UGC (tính năng "Gửi mail cho các bạn đã chọn") ======
# Cách đơn giản nhất: dùng chính Gmail công ty bạn, KHÔNG dùng mật khẩu Gmail thường mà phải
# tạo "Mật khẩu ứng dụng" (App Password) - xem hướng dẫn trong README mục "Gửi email cho UGC".
MAIL_USER="ten-cong-ty@gmail.com"
MAIL_PASSWORD="mat-khau-ung-dung-16-ky-tu"
MAIL_FROM_NAME="Tên công ty của bạn"

# (Tuỳ chọn) nếu muốn dùng SMTP riêng thay vì Gmail (Zoho, Outlook, dịch vụ email công ty...)
# thì khai báo thêm 3 dòng dưới đây, hệ thống sẽ tự ưu tiên dùng SMTP này thay vì Gmail:
# MAIL_HOST="smtp.your-provider.com"
# MAIL_PORT="587"
# MAIL_SECURE="false"
